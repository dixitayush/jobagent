# ─────────────────────────────────────────────────────────────────────────────
# AI Job Agent — the ONE environment file for every app (api, worker, scheduler, web).
#
# Local dev:  cp .env.example .env  →  ./deploy-local.sh infra  →  npm run dev
# Local full: ./deploy-local.sh     (Docker stack at http://localhost:8081)
# VPS:        ./deploy.sh           (creates/fills .env on the server: host, URL, secrets)
#
# The compose files override DATABASE_URL / REDIS_URL with in-network hostnames,
# so the localhost values below are only used by `npm run dev`.
# ─────────────────────────────────────────────────────────────────────────────

# ---------- Public (VPS) ----------
# Hostname Traefik routes to this stack. Needs an A record pointing at the VPS.
JOBAGENT_HOST=jobagent.ayushdixit.work
# Public origin of the dashboard. Used in emails, cookies and CORS. Must be https in production.
APP_URL=http://localhost:3000
# Base URL for email tracking links (same origin as APP_URL: Caddy routes /api to the API).
API_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# local | production — production enables strict config checks (secure secrets, https, no dev login).
APP_ENV=local
LOG_LEVEL=info

# ---------- Postgres (+ pgvector) ----------
# Letters and digits only: it is embedded in a connection URL.
POSTGRES_USER=user
POSTGRES_PASSWORD=change
POSTGRES_DB=jobagent
DATABASE_URL=postgres://user:password@localhost:5435/jobagent

# ---------- Redis (BullMQ queues, cache, rate limits) ----------
REDIS_URL=redis://localhost:6381

# ---------- API ----------
PORT=4000
# Internal-only port for /internal/* and /metrics (never routed by Caddy/Traefik).
INTERNAL_PORT=4001
INTERNAL_API_TOKEN=dev-internal-token-change-me
# Web (npm run dev) proxies /api to this URL.
API_INTERNAL_URL=http://localhost:4000

# ---------- Auth ----------
# Google OAuth "Web application" client ID (https://console.cloud.google.com/apis/credentials).
# Authorized JavaScript origins: http://localhost:3000, http://localhost:8081, https://<JOBAGENT_HOST>
GOOGLE_CLIENT_ID=
# Local only: email/name sign-in without Google. Always off when APP_ENV=production.
AUTH_DEV_LOGIN=true
# Comma-separated emails that get the admin dashboard.
ADMIN_EMAILS=dixitayush284@gmail.com
# ≥32 chars. Generate: openssl rand -base64 48
JWT_SECRET=dev-jwt-secret-change-me-dev-jwt-secret-change-me
SESSION_TTL_HOURS=168

# ---------- Resume storage (encrypted at rest, Docker volume in containers) ----------
# 32 random bytes, base64. Generate: openssl rand -base64 32   (changing it makes old resumes unreadable)
ENCRYPTION_KEY=change_me_in_prod
STORAGE_LOCAL_DIR=./.data/uploads
MAX_RESUME_BYTES=5242880

# ---------- AI (LangChain providers) ----------
# openai | anthropic | gemini | none  (none = rules + vector matching only; admins can switch at runtime)
LLM_PROVIDER=openai
# Strong model: borderline match evaluation. Small model: resume parsing + job understanding.
# GPT-5 pricing (per 1M in/out): gpt-5 $1.25/$10, gpt-5-mini $0.25/$2; cached input is 90% cheaper.
LLM_MODEL=gpt-5
LLM_SMALL_MODEL=gpt-5-mini
# Reasoning effort (minimal | low | medium | high): strong tier = match evaluation, small = extraction.
LLM_REASONING_EFFORT=medium
LLM_SMALL_REASONING_EFFORT=low
LLM_TIMEOUT_MS=180000
# https://platform.openai.com/api-keys — also used for embeddings.
OPENAI_API_KEY=
# Optional alternative providers (select with LLM_PROVIDER or from the admin page).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# openai | gemini | local (free, offline hashing embeddings; used automatically when no API key is set)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Optional pricing overrides, USD per 1M tokens: {"model-id":[input,output]}
# LLM_PRICING_JSON=

# ---------- Email (Resend) ----------
# resend | smtp | console. Without RESEND_API_KEY emails are only logged.
EMAIL_PROVIDER=resend
# https://resend.com/api-keys
RESEND_API_KEY=
# Must use a domain verified in Resend (https://resend.com/domains).
# For quick local tests without a domain use: AI Job Agent <onboarding@resend.dev> (delivers only to your Resend account email).
EMAIL_FROM=AI Job Agent <jobs@jobagent.ayushdixit.work>
# Only used when EMAIL_PROVIDER=smtp.
SMTP_URL=smtp://localhost:1025

# ---------- Crawler ----------
CRAWLER_USER_AGENT=JobAgentBot/1.0 (+https://jobagent.ayushdixit.work/bot)
CRAWL_TIMEOUT_MS=20000
CRAWL_MAX_BYTES=8388608
# Never enable outside local fixture testing: disables SSRF private-network blocking.
CRAWL_ALLOW_PRIVATE_NETWORKS=false

# ---------- Job portals (official partner APIs only; no scraping) ----------
LINKEDIN_PARTNER_API_KEY=
NAUKRI_PARTNER_API_KEY=

# ---------- Local stack ----------
JOBAGENT_LOCAL_PORT=8081
